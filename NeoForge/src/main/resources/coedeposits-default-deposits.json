  "_examples_intro": "──────── EXAMPLES — feature showcase ──────── Below are 6 deposit types demonstrating every feature the mod offers. They have non-zero weights so they spawn naturally alongside the vanilla single-recipe entries above; remove them or set weight=0 if you only want the classic ones. Each entry has a _note explaining what it demonstrates.",

  "_example_per_block_mix_note": "PER-BLOCK MIX via COE's native weighted drilling output. Every drill cycle on every chunk independently rolls each output: 65% iron, 35% copper, +20% cobblestone, +10% gravel. Yield 'плавает' naturally because rolls are independent. ALL chunks of this deposit share the inline drilling recipe synthesised by the BundledRecipePack virtual datapack — no separate datapack file needed, everything is in this entry below.",
  "coedeposits:example_per_block_mix": {
    "vein": {
      "display_name": "Iron-Copper Mixed Vein",
      "amount_multiplier_min": 2.0,
      "amount_multiplier_max": 25.0,
      "icon": "minecraft:raw_iron"
    },
    "drilling": {
      "outputs": [
        {"item": "minecraft:raw_iron",    "chance": 0.65},
        {"item": "minecraft:raw_copper",  "chance": 0.35},
        {"item": "minecraft:cobblestone", "chance": 0.2},
        {"item": "minecraft:gravel",      "chance": 0.1}
      ],
      "ticks": 100,
      "stress": 256
    },
    "dimensions": "minecraft:overworld",
    "distance": {"min": 1000, "max": 2147483647},
    "size_chunks": {"min": 6, "max": 18},
    "per_chunk_units": {"min": 25000, "max": 180000},
    "weight": 50,
    "map_color": 12555079,
    "biome_filter": ["c:is_mountain", "minecraft:is_jungle"]
  },

